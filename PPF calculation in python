emi=4000
roi=0.071
term=5
principal=emi
totaldeposit=emi
for i in range(term):
    for j in range(12):
        interest=principal*roi/12
        principal+=interest
        principal+=emi
        totaldeposit+=emi
totaldeposit-=emi
